function testAssert(%name, %got, %expected)
{
    %epsilon = 0.0001;
    %diff = mAbs(%got - %expected);

    if (%diff < %epsilon)
    {
        print("[PASS] " @ %name @ " -> Got: " @ %got);
    }
    else
    {
        error("[FAIL] " @ %name @ " -> expected: " @ %expected @ ", but got: " @ %got);
        $failCount++;
    }
}

function runMathTests()
{
    $failCount = 0;
    print("=== math function test >>>>> ===");
    // ==========================================
    printSeparator();
    print ("Random Test");
    printSeparator();
    %ok = true;
    for (%i in RANGE 100)  {
       %val =  math.randomF();
       if (%val < 0.0 || %val > 1.0 ) { %ok = false;}
    }
    testAssert(" math.randomF()",       true,       %ok);

    %ok = true;
    for (%i in RANGE 100)  {
        %val =  math.randomF(4);
        if (%val < 0.0 || %val > 4.0 ) { %ok = false;}
    }
    testAssert(" math.randomF(4)",       true,       %ok);
    %negCount = 0;
    %posCount = 0;
    for (%i in RANGE 100)  {
        %val =  math.randomF(-1.0,1.0);
        if (%val < 0.0 && %val >= -1.0 ) { %negCount++;}
        if (%val >= 0.0 && %val <= 1.0 ) { %posCount++;}
    }
    %ok = (%negCount > 0 && %posCount > 0);
    testAssert(" mmath.randomF(-1.0,1.0)",       true,       %ok);


    printSeparator();
    print ("1 Parameter Tests");
    printSeparator();
    testAssert("math.floor",       math.floor(4.7),       4);
    testAssert("math.ceil",        math.ceil(4.1),        5);
    testAssert("math.fabs",        math.fabs(-12.34),     12.34);
    testAssert("math.sin",         math.sin(0),           0);
    testAssert("math.cos",         math.cos(0),           1);
    testAssert("math.atan",        math.atan(1),          0.785398); // pi/4
    testAssert("math.tanh",        math.tanh(0),          0);
    testAssert("math.sqrt",        math.sqrt(16),         4);
    testAssert("math.iszero (w)",  math.iszero(0),        1);
    testAssert("math.iszero (f)",  math.iszero(5),        0);

    printSeparator();
    print ("2 Parameter Tests");
    printSeparator();

    testAssert("math.fmod",        math.fmod(5.3, 2),     1.3);
    testAssert("math.min",         math.min(10, 20),      10);
    testAssert("math.max",         math.max(10, 20),      20);
    testAssert("math.atan2",       math.atan2(1, 1),      0.785398);
    testAssert("math.pow",         math.pow(2, 3),        8);

    printSeparator();
    print ("3 Parameter Tests");
    printSeparator();

    testAssert("math.clamp (bottom)", math.clamp(2, 5, 10),    5);
    testAssert("math.clamp (mittle)", math.clamp(7, 5, 10),    7);
    testAssert("math.clamp (top)",    math.clamp(12, 5, 10),   10);

    testAssert("math.clampf (bottom)", math.clampf(2.1, 5.4, 10.7),    5.4);
    testAssert("math.clampf (mittle)", math.clampf(7.4, 5.3, 10.4),    7.4);
    testAssert("math.clampf (top)",    math.clampf(12.3, 5.2, 10.8),   10.8);

    testAssert("math.lerp",          math.lerp(10, 20, 0.5),  15);

    testAssert("math.smoothstep",    math.smoothstep(0, 1, 0.5), 0.5);

    print("=== <<<<< math function test");
    printSeparator();
    if ($failCount > 0 ) {
        error(" some functions (",$failCount,") failed !!!!!!!!!!!!!!!!!!!!!!!!!");
    } else {
        print(" Inline Math seams to work perfect :)");
    }
}

runMathTests();
