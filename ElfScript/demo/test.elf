function cacheSaveBug2(%i) {
    %bar = new Object() { TypeString text = "BAT" @ %i; TypeVector color = {0, %i}; };
    %knorz = new Object() { TypeString text = "KNORZ" @ %i; TypeVector color = {0, %i}; };
    printf("II #%d %s %s &&  %s %s", %i, %bar.text, %bar.color, %knorz.text, %knorz.color);
    $myGroup.push_back(%bar);
    $myGroup.push_back(%knorz);
}

function cacheSaveBug(%i) {
    %bar = new Object() { TypeString text = "BAT" @ %i; TypeVector color = {0, %i}; };
    %knorz = new Object() { TypeString text = "KNORZ" @ %i; TypeVector color = {0, %i}; };
    printf("#%d %s %s &&  %s %s", %i, %bar.text, %bar.color, %knorz.text, %knorz.color);
    $myGroup.push_back(%bar);
    $myGroup.push_back(%knorz);
}

for (%i in range 10) {
    if (%i % 3 == 0) $myGroup.pop_front();
         // $myGroup.clear();
    print("COUNT", $myGroup.size());
    cacheSaveBug(%i);
}
