    */
      function at( int index );
   /** --- ConsoleValue first ---
    * fetch first 
    * @return ConsoleValue
    */
      function first();
   /** --- ConsoleValue last ---
    * fetch last 
    * @return ConsoleValue
    */
      function last();
   /** --- S32 size ---
    * get the size
    * @return S32
    */
      function size();
   /** --- void clear ---
    * clear the Vector
    */
      function clear();
   /** --- void reserve ---
    * reserve elements in the array
    */
      function reserve( uint size );
   /** --- void fill ---
    * fill the array with value
    */
      function fill( ConsoleValue value );
   /** --- void push_back ---
