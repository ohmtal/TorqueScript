   /** --- const char* SDL_GetBasePath ---
    * Get the directory where the application was run from.
    * @return const char*
    */
      function SDL_GetBasePath();
   /** --- const char* SDL_GetCurrentDirectory ---
    * Get what the system believes is the current working directory.
    * @return const char*
    */
      function SDL_GetCurrentDirectory();
   /** --- String SDL_GetPrefPath ---
    * Get the user-and-app-specific path where files can be written.
    * @return String
    */
      function SDL_GetPrefPath( string org, string app );
   /** --- bool SDL_SaveFile ---
    * save data to a file.
    * @return bool
    */
      function SDL_SaveFile( string path, string data, uint size=0 );
   /** --- const char* SDL_LoadFile ---
    * load data from a file.
    * @return const char*
    */
      function SDL_LoadFile( string path );
   /** --- void SDL_RENDERER_INIT ---
    * initialize the ElfSDL3::SDL3_Render System
    */
      function SDL_RENDERER_INIT();
   /** --- void SDL_RENDERER_SHUTDOWN ---
    * shutdown and unload the ElfSDL3::SDL3_Render System
    */
      function SDL_RENDERER_SHUTDOWN();
   /** --- S32 SDL_GetNumRenderDrivers ---
    * @return S32
    */
      function SDL_GetNumRenderDrivers();
   /** --- const char * SDL_GetRenderDriver ---
    * @return const char *
    */
      function SDL_GetRenderDriver( int index );
   /** --- const char * SDL_CreateWindowAndRenderer ---
    * This create a SDL_Window and SDL_Renderer.
    * @return String: '1 [WindowID] [RenderID]' or '0' if failed
    * @return const char *
    */
      function SDL_CreateWindowAndRenderer( string title, int width, int height, U64 window_flags );
   /** --- S32 SDL_CreateWindow ---
    * This create a SDL_Window and SDL_Renderer
    * @return S32 WindowID
    * @return S32
    */
      function SDL_CreateWindow( string title, int width, int height, U64 window_flags );
   /** --- bool SDL_SetWindowTitle ---
    * Set a Window Title
    * @return bool
    */
      function SDL_SetWindowTitle( int WindowID, string title );
   /** --- String SDL_GetWindowTitle ---
    * Get a Window Title
    * @return String
    */
      function SDL_GetWindowTitle( int WindowID );
   /** --- bool SDL_SetWindowIcon ---
    * Set a Window Icon from Surface
    * @return bool
    */
      function SDL_SetWindowIcon( int WindowID, int SurfaceID );
   /** --- bool SDL_SetWindowPosition ---
    * Set the Window position
    * @return bool
    */
      function SDL_SetWindowPosition( int WindowID, int x, int y );
   /** --- bool SDL_SetWindowSize ---
    * Set the Window Size
    * @return bool
    */
      function SDL_SetWindowSize( int WindowID, int width, int height );
   /** --- bool SDL_StartTextInput ---
    * start text input mode for input onSDLTextInputEvent(%text)
    * @return bool
    */
      function SDL_StartTextInput( int WindowID );
   /** --- bool SDL_StopTextInput ---
    * STOP text input mode for input onSDLTextInputEvent(%text)
    * @return bool
    */
      function SDL_StopTextInput( int WindowID );
   /** --- bool SDL_SetWindowMinimumSize ---
    * Set the Window minimum Size
    * @return bool
    */
      function SDL_SetWindowMinimumSize( int WindowID, int width, int height );
   /** --- bool SDL_SetWindowMaximumSize ---
    * Set the Window maximum Size
    * @return bool
    */
      function SDL_SetWindowMaximumSize( int WindowID, int width, int height );
   /** --- bool SDL_SetWindowBordered ---
    * Set bordered
    * @return bool
    */
      function SDL_SetWindowBordered( int WindowID, bool bordered );
   /** --- bool SDL_SetWindowResizable ---
    * Set resizable
    * @return bool
    */
      function SDL_SetWindowResizable( int WindowID, bool resizable );
   /** --- bool SDL_SetWindowFullscreen ---
    * Set fullscreen
    * @return bool
    */
      function SDL_SetWindowFullscreen( int WindowID, bool fullscreen );
   /** --- S32 SDL_CreatePopupWindow ---
    * This create a SDL_Window and SDL_Renderer
    * @return S32 WindowID
    * @return S32
    */
      function SDL_CreatePopupWindow( int parentWindowID, int offset_x, int offset_y, int w, int h, U64 window_flags=SDL_WINDOW_POPUP_MENU );
   /** --- bool SDL_DestroyWindow ---
    * destroy a window
    * @return bool
    */
      function SDL_DestroyWindow( int windowID );
   /** --- S32 SDL_CreateRenderer ---
    * Create a renderer for a Window. If name is empty SDL decide the renderer (default)
    * @return S32 RendererID
    * @return S32
    */
      function SDL_CreateRenderer( int windowID, string name="" );
   /** --- S32 SDL_CreateTexture ---
    * This create a Texture.
    * @return S32 TextureID
    * @return S32
    */
      function SDL_CreateTexture( int rendererID, int pixelFormat, int textureAccces, int w, int h );
   /** --- S32 SDL_LoadSurface ---
    * load a surface from file. @return SurfaceID
    * @return S32
    */
      function SDL_LoadSurface( string filename );
   /** --- bool SDL_DestroySurface ---
    * unload a surface
    * @return bool
    */
      function SDL_DestroySurface( int SurfaceID );
   /** --- S32 SDL_CreateTextureFromSurface ---
    * This create a Texture by SurfaceID.
    * @return S32 TextureID
    * @return S32
    */
      function SDL_CreateTextureFromSurface( int rendererID, int SurfaceID );
   /** --- ConsoleVector SDL_GetTextureSize ---
    * get the size of a texture as float Point
    * @return ConsoleVector
    */
      function SDL_GetTextureSize( int textureID );
   /** --- ConsoleVector SDL_GetTextureRect ---
    * get the size of a texture as float Rectangle (ElfSDL3 extension)
    * @return ConsoleVector
    */
      function SDL_GetTextureRect( int textureID );
   /** --- bool SDL_SetTextureColorMod ---
    * set the color for a texture. default white for reset
    * @return bool
    */
      function SDL_SetTextureColorMod( int textureID, U8 r=255, U8 g=255, U8 b=255 );
   /** --- bool SDL_SetTextureAlphaMod ---
    * set the alpha for a texture, default 255 for reset
    * @return bool
    */
      function SDL_SetTextureAlphaMod( int textureID, U8 a=255 );
   /** --- bool SDL_SetTextureBlendMode ---
    * set the BlendMode for a texture, default SDL_BLENDMODE_NONE
    * @return bool
    */
      function SDL_SetTextureBlendMode( int textureID, uint blendMode=SDL_BLENDMODE_NONE );
   /** --- bool SDL_SetRenderLogicalPresentation ---
    * Set SDL_SetRenderLogicalPresentation which does scale the screen.
    * Warning: ImGui windows (like console) looks a bit strange than!
    * @return bool
    */
      function SDL_SetRenderLogicalPresentation( int RendererID, int logicalWidth, int logicalHeight, int mode=(S32)SDL_LOGICAL_PRESENTATION_STRETCH );
   /** --- bool SDL_SetRenderScale ---
    * set the render scale - default 1.f
    * @return bool
    */
      function SDL_SetRenderScale( int rendererID, float scaleX=1.f, float scaleY=1.f );
   /** --- bool SDL_SetRenderDrawColor ---
    * set the render color
    * @return bool
    */
      function SDL_SetRenderDrawColor( int rendererID, U8 r, U8 g, U8 b, U8 a=255 );
   /** --- bool SDL_SetRenderDrawColorVec ---
    * set the render color
    * @return bool
    */
      function SDL_SetRenderDrawColorVec( int rendererID, ConsoleVector colorVec );
   /** --- bool SDL_SetRenderDrawBlendMode ---
    * set the blendmode, without parameter NONE = disabled is set.
    * @return bool
    */
      function SDL_SetRenderDrawBlendMode( int rendererID, uint blendMode=SDL_BLENDMODE_NONE );
   /** --- bool SDL_RenderClear ---
    * clear the current render device - called before the drawing begin - see also SDL_SetRenderDrawColor
    * @return bool
    */
      function SDL_RenderClear( int rendererID );
   /** --- bool SDL_RenderPoint ---
    * render a Point
    * @return bool
    */
      function SDL_RenderPoint( int rendererID, float x, float y );
   /** --- bool SDL_RenderLine ---
    * render a Line
    * @return bool
    */
      function SDL_RenderLine( int rendererID, float x1, float y1, float x2, float y2 );
   /** --- bool SDL_RenderRect ---
    * render a Rect (unfilled)
    * @return bool
    */
      function SDL_RenderRect( int rendererID, RectF rect );
   /** --- bool SDL_RenderFillRect ---
    * render a Rect (filled)
    * @return bool
    */
      function SDL_RenderFillRect( int rendererID, RectF rect );
   /** --- bool SDL_RenderRectF ---
    * render a Rect  with float parameters and filled or not (not nativ SDL3)
    * @return bool
    */
      function SDL_RenderRectF( int rendererID, float x, float y, float w, float h, bool filled=true );
   /** --- bool SDL_RenderTexture ---
    * render texture from src Rect to dstRect
    * @return bool
    */
      function SDL_RenderTexture( int rendererID, int textureID, RectF srcRect, RectF dstRect );
   /** --- bool SDL_RenderTextureRotated ---
    * render texture rotated and flipped from srcRect to dstRect
    * @return bool
    */
      function SDL_RenderTextureRotated( int rendererID, int textureID, RectF srcRect, RectF dstRect, F64 angle, Point2F centerPoint, int sdl_flipmode );
   /** --- bool SDL_RenderPresent ---
    * called all the rendering(drawing) is done
    * @return bool
    */
      function SDL_RenderPresent( int rendererID );
   /** --- bool SDL_DestroyTexture ---
    * remove a renderer
    * @return bool
    */
      function SDL_DestroyTexture( int TextureID );
   /** --- bool SDL_DestroyRenderer ---
    * remove a renderer
    * @return bool
    */
      function SDL_DestroyRenderer( int rendererID );
   /** --- bool SDL_SetRenderVSync ---
    * set vertical sync on/off
    * @return bool
    */
      function SDL_SetRenderVSync( int rendererID, int value );
   /** --- S32 SDL_GetRenderVSync ---
    * get vertical sync is on/off
    * @return S32
    */
      function SDL_GetRenderVSync( int rendererID );
   /** --- bool SDL_RenderDebugText ---
    * called all the rendering(drawing) is done
    * @return bool
    */
      function SDL_RenderDebugText( int rendererID, float x, float y, string str );
   /** --- bool SDL_PointInRect ---
    * Check a point is in rect
    * @return bool
    */
      function SDL_PointInRect( Point2F p, RectF rect );
   /** --- bool SDL_PointInRectFloat ---
    * Check a point is in rect
    * @return bool
    */
      function SDL_PointInRectFloat( Point2F p, RectF rect );
   /** --- bool SDL_HasRectIntersection ---
    * Check rect intersection
    * @return bool
    */
      function SDL_HasRectIntersection( RectI rectA, RectI rectB );
   /** --- bool SDL_HasRectIntersectionFloat ---
    * Check rect intersection
    * @return bool
    */
      function SDL_HasRectIntersectionFloat( RectF rectA, RectF rectB );
   /** --- ConsoleVector SDL_GetRectIntersectionFloat ---
    * get rect intersection (overlap)
    * @return ConsoleVector
    */
      function SDL_GetRectIntersectionFloat( RectF rectA, RectF rectB );
   /** --- ConsoleVector SDL_GetRectUnionFloat ---
    * get rect unio both rects combined to one big.
    * @return ConsoleVector
    */
      function SDL_GetRectUnionFloat( RectF rectA, RectF rectB );
   /** --- bool SDL_GetRectAndLineIntersectionFloat ---
    * check if a rect and a line intersects
    * @return bool
    */
      function SDL_GetRectAndLineIntersectionFloat( RectF rect, float x1, float y1, float x2, float y2 );
   /** --- const char* SDL_GetStringProperty ---
    * get string for a property.
    * @return const char*
    */
      function SDL_GetStringProperty( int propertiesID, string key );
   /** --- bool SDL_Init ---
    * Init SDL default Video and Audio
    * @return bool
    */
      function SDL_Init( int InitFlags=SDL_INIT_VIDEO | SDL_INIT_AUDIO );
   /** --- void SDL_Quit ---
    * Quit SDL
    */
      function SDL_Quit();
   /** --- U64 SDL_GetTicks ---
    * Get the number of milliseconds that have elapsed since the SDL library
    * @return U64
    */
      function SDL_GetTicks();
   /** --- U64 SDL_GetTicksNS ---
    * Get the number of nanoseconds that have elapsed since the SDL library
    * @return U64
    */
      function SDL_GetTicksNS();
   /** --- U64 SDL_GetPerformanceCounter ---
    * Get the current value of the high resolution counter.
    * @return U64
    */
      function SDL_GetPerformanceCounter();
   /** --- U64 SDL_GetPerformanceFrequency ---
    * Get the count per second of the high resolution counter.
    * @return U64
    */
      function SDL_GetPerformanceFrequency();
   /** --- void SDL_Delay ---
    * Wait a specified number of milliseconds before returning.
    */
      function SDL_Delay( uint ms );
   /** --- void SDL_DelayNS ---
    * Wait a specified number of nanoseconds before returning.
    */
      function SDL_DelayNS( U64 ns );
   /** --- void SDL_DelayPrecise ---
    * Wait a specified number of nanoseconds before returning.
    */
      function SDL_DelayPrecise( U64 ns );
   /** --- void SDL_SetClipboardText ---
    * Push text into the Clipboard.
    */
      function SDL_SetClipboardText( string text );
   /** --- const char* SDL_GetClipboardText ---
    * Get text from the Clipboard.
    * @return const char*
    */
      function SDL_GetClipboardText();
   /** --- bool Audio_Init ---
    * Init Audio Device for playback
    * @return bool
    */
      function Audio_Init();
   /** --- void Audio_Shutdown ---
    * ShutDown Audio Device 
    */
      function Audio_Shutdown();
   /** --- S32 Audio_LoadWav ---
    * Load a Wave File.
    * @return WavID
    * @return S32
    */
      function Audio_LoadWav( string filename );
   /** --- S32 Audio_UnLoadWav ---
    * Unload a Wave Steam
    * @return S32
    */
      function Audio_UnLoadWav( int WavID );
   /** --- bool Audio_Play ---
    * Play a Wave Stream.@param gain is the normalized volume
    * @return bool
    */
      function Audio_Play( int WavID, float gain=1.0f, bool loop=false );
   /** --- bool Audio_Stop ---
    * Stop a Wave Stream.
    * @return bool
    */
      function Audio_Stop( int WavID );
   /** --- bool Audio_SetMasterVolume ---
    * set the volume for all streams
    * @return bool
    */
      function Audio_SetMasterVolume( float volume );
   /** --- F32 Audio_GetMasterVolume ---
    * get the volume for all streams
    * @return F32
    */
      function Audio_GetMasterVolume();
   /** --- S32 TestMidi ---
    * make a midi test ....
    * @return S32
    */
      function TestMidi();
   /** --- S32 MelodyBegin ---
    * create a melody maker
    * @return S32
    */
      function MelodyBegin();
   /** --- bool MelodyAdd ---
    * data: {(int)LINENUMBER, (int)MIDITONE, (float) duration=0.2f, (float)amplitude=0.2f}
    * add a tone at line number - in line exists it will be overwritten
    * @return bool
    */
      function MelodyAdd( int MelodyID, ConsoleVector data );
   /** --- bool MelodyDel ---
    * Delete tone at linenumber
    * @return bool
    */
      function MelodyDel( int MelodyID, int lineNumber );
   /** --- String MelodyList ---
    * list the melody
    * @return String
    */
      function MelodyList( int MelodyID, int lineNumberStart=-1, int lineNumberEnd=-1 );
   /** --- bool MelodyRun ---
    * run = play the melody
    * @return bool
    */
      function MelodyRun( int MelodyID, float gain=1.0 );
   /** --- S32 MelodyGen ---
    * gen = generate wavData from this melody
    * @return S32
    */
      function MelodyGen( int MelodyID );
   /** --- bool MelodyEnd ---
    * remove this melody - if you used MelodyGen: the wave data will not be touched
    * @return bool
    */
      function MelodyEnd( int MelodyID );
};
